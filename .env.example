# Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://erp_admin:erp_secret@localhost:5432/erp_db?schema=public
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_secret
POSTGRES_DB=erp_db
POSTGRES_PORT=5432

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Messaging (RabbitMQ)
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Security & JWT
JWT_SECRET=super-secret-jwt-key-replace-in-production-change-this-now!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
