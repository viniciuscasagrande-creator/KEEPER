# =============================================================================
# KEEPER ERP — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.production on your server and update the secrets.
# =============================================================================

# --- Node Environment ---
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# --- Frontend & CORS Origins ---
# Default official production frontend on Vercel
CORS_ORIGIN=https://keeper-tng6.vercel.app,http://localhost:5173

# --- Security & JWT Authentication ---
# Generate a strong 64-character secret using: openssl rand -base64 48
JWT_SECRET=super-secret-jwt-key-replace-in-production-change-this-now!
JWT_EXPIRES_IN=24h

# --- PostgreSQL 16 Database Configuration ---
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_secret_prod_2026_change_me
POSTGRES_DB=erp_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp_admin:erp_secret_prod_2026_change_me@postgres:5432/erp_db?schema=public

# --- Redis 7 In-Memory Cache & Session ---
REDIS_PORT=6379
REDIS_PASSWORD=erp_redis_secret_prod_change_me
REDIS_URL=redis://:erp_redis_secret_prod_change_me@redis:6379/0

# --- RabbitMQ 3.13 Message Broker & Queues ---
RABBITMQ_USER=erp_mq_admin
RABBITMQ_PASS=erp_mq_secret_prod_change_me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://erp_mq_admin:erp_mq_secret_prod_change_me@rabbitmq:5672

# --- Ports Exposed ---
API_PORT=4000
WORKER_PORT=4001

# --- Gateway & Adquirentes Secrets (Optional overrides) ---
PAGARME_API_KEY=pk_live_stone_production_default
MERCAOPAGO_ACCESS_TOKEN=APP_USR_production_default
CIELO_MERCHANT_ID=cielo_merchant_id_prod_default
CIELO_MERCHANT_KEY=cielo_merchant_key_prod_default
STONE_CODE=stone_merchant_code_default

# --- Antifraude Providers ---
CLEARSALE_CLIENT_ID=clearsale_prod_id
CLEARSALE_CLIENT_SECRET=clearsale_prod_secret
KONDUTO_PUBLIC_KEY=konduto_prod_public_key
