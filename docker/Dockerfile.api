# syntax=docker/dockerfile:1
# =============================================================================
# KEEPER ERP — Production Dockerfile for @erp/api (NestJS REST API)
# Multi-stage build optimized for security, caching and minimal attack surface
# =============================================================================

# --- Stage 1: Base Alpine with PNPM ---
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.5.2 --activate
RUN apk add --no-cache libc6-compat openssl wget

# --- Stage 2: Monorepo Dependencies Installation ---
FROM base AS deps
WORKDIR /app

# Copy root workspace configuration and manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/tsconfig/ packages/tsconfig/
COPY packages/shared/package.json packages/shared/
COPY packages/database/package.json packages/database/
COPY packages/auth/package.json packages/auth/
COPY packages/events/package.json packages/events/
COPY packages/rules/package.json packages/rules/
COPY packages/ui/package.json packages/ui/
COPY packages/notifications/package.json packages/notifications/
COPY packages/storage/package.json packages/storage/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/

# Install dependencies with frozen lockfile
RUN pnpm install --frozen-lockfile

# --- Stage 3: Monorepo Build ---
FROM base AS builder
WORKDIR /app
COPY --from=deps /app ./
COPY packages/ packages/
COPY apps/api/ apps/api/

# Generate Prisma Client & compile packages
RUN pnpm --filter @erp/database build
RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/auth build
RUN pnpm --filter @erp/events build
RUN pnpm --filter @erp/rules build
RUN pnpm --filter @erp/api build

# --- Stage 4: Production Runner ---
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV API_PREFIX="api/v1"

# Create non-root user for security hardening (CIS Benchmark)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 erpuser

# Copy built artifacts and necessary runtime files
COPY --from=builder --chown=erpuser:nodejs /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=erpuser:nodejs /app/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=erpuser:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=erpuser:nodejs /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder --chown=erpuser:nodejs /app/packages/events/dist ./packages/events/dist
COPY --from=builder --chown=erpuser:nodejs /app/packages/rules/dist ./packages/rules/dist
COPY --from=builder --chown=erpuser:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=erpuser:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=erpuser:nodejs /app/package.json ./package.json
COPY --from=builder --chown=erpuser:nodejs /app/apps/api/package.json ./apps/api/package.json

# Switch to non-privileged user
USER erpuser

# Expose API service port
EXPOSE 4000

# Container healthcheck probe
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/health || exit 1

# Start NestJS API service
CMD ["node", "apps/api/dist/main"]
