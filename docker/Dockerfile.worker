# syntax=docker/dockerfile:1
# =============================================================================
# KEEPER ERP — Production Dockerfile for @erp/worker (Background Async Worker)
# Consumes RabbitMQ events, manages scheduled jobs and reconciliation tasks
# =============================================================================

# --- Stage 1: Base Alpine with PNPM ---
FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.5.2 --activate
RUN apk add --no-cache libc6-compat openssl wget

# --- Stage 2: Monorepo Dependencies Installation ---
FROM base AS deps
WORKDIR /app

# Copy root workspace configuration and manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/tsconfig/ packages/tsconfig/
COPY packages/shared/package.json packages/shared/
COPY packages/database/package.json packages/database/
COPY packages/auth/package.json packages/auth/
COPY packages/events/package.json packages/events/
COPY packages/rules/package.json packages/rules/
COPY packages/ui/package.json packages/ui/
COPY packages/notifications/package.json packages/notifications/
COPY packages/storage/package.json packages/storage/
COPY apps/api/package.json apps/api/
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/

# Install dependencies with frozen lockfile
RUN pnpm install --frozen-lockfile

# --- Stage 3: Monorepo Build ---
FROM base AS builder
WORKDIR /app
COPY --from=deps /app ./
COPY packages/ packages/
COPY apps/worker/ apps/worker/

# Generate Prisma Client & compile packages
RUN pnpm --filter @erp/database build
RUN pnpm --filter @erp/shared build
RUN pnpm --filter @erp/events build
RUN pnpm --filter @erp/worker build

# --- Stage 4: Production Runner ---
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4001

# Create non-root user for security hardening
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 erpworker

# Copy built artifacts and necessary runtime files
COPY --from=builder --chown=erpworker:nodejs /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=erpworker:nodejs /app/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=erpworker:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=erpworker:nodejs /app/packages/events/dist ./packages/events/dist
COPY --from=builder --chown=erpworker:nodejs /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder --chown=erpworker:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=erpworker:nodejs /app/package.json ./package.json
COPY --from=builder --chown=erpworker:nodejs /app/apps/worker/package.json ./apps/worker/package.json

USER erpworker

EXPOSE 4001

CMD ["node", "apps/worker/dist/main.js"]
