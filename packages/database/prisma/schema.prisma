model Project {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid
  code      String
  name      String
  managerId String? @map("manager_id") @db.Uuid
  startDate DateTime? @db.Date @map("start_date")
  endDate   DateTime? @db.Date @map("end_date")
  budget    Decimal @default(0) @db.Decimal(19,4)
  status    String @default("PLANNED")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  manager User? @relation(fields: [managerId], references: [id])
  tasks ProjectTask[]

  @@unique([companyId, code])
  @@schema("projetos")
  @@map("projects")
}

model ProjectTask {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  parentId      String? @map("parent_id") @db.Uuid
  name          String
  assignedTo    String? @map("assigned_to") @db.Uuid
  startDate     DateTime? @db.Date @map("start_date")
  dueDate       DateTime? @db.Date @map("due_date")
  status        String @default("TODO")
  estimatedHours Decimal? @db.Decimal(10,2) @map("estimated_hours")
  actualHours    Decimal? @db.Decimal(10,2) @map("actual_hours")

  project Project @relation(fields: [projectId], references: [id])
  parent ProjectTask? @relation("TaskHierarchy", fields: [parentId], references: [id])
  children ProjectTask[] @relation("TaskHierarchy")
  assignee User? @relation(fields: [assignedTo], references: [id])

  @@schema("projetos")
  @@map("project_tasks")
}

model FixedAsset {
