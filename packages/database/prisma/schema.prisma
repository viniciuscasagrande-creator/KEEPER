generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "financeiro", "contabil", "fiscal", "rh", "compras", "estoque", "vendas", "crm", "contratos", "projetos", "ativos", "servicos", "bi", "integracoes"]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
  @@schema("core")
}

enum UserStatus {
  ACTIVE
  INVITED
  BLOCKED
  DISABLED
  @@schema("core")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  @@schema("core")
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  @@schema("core")
}

enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  @@schema("core")
}

enum FinancialAccountType {
  CASH
  CHECKING
  SAVINGS
  INVESTMENT
  DIGITAL_WALLET
  ESCROW_CLEARING
  OTHER
  @@schema("financeiro")
}

enum FeeCalculationType {
  PERCENTAGE
  FIXED_AMOUNT
  HYBRID
  PER_TICKET
  PER_ORDER
  PER_EVENT
  @@schema("financeiro")
}

enum FeePayer {
  CUSTOMER
  PRODUCER
  DISKINGRESSOS
  SHARED
  @@schema("financeiro")
}

enum FeeDestination {
  DISKINGRESSOS_REVENUE
  RESERVE_FUND
  GATEWAY_COST
  PARTNER_SHARE
  @@schema("financeiro")
}

enum FeeApplicationChannel {
  ONLINE
  BOX_OFFICE
  BOTH
  @@schema("financeiro")
}

enum FeeChargeMoment {
  AT_SALE
  AT_SETTLEMENT
  AT_TRANSFER
  AT_CLOSING
  AT_ADVANCE
  @@schema("financeiro")
}

enum EventExpenseCategory {
  SECURITY
  VENUE_RENTAL
  ARTIST_CACHE
  STAGE_STRUCTURE
  MARKETING
  STAFF
  TICKETING_EQUIPMENT
  OTHER
  @@schema("financeiro")
}

enum SettlementScheduleStatus {
  PENDING
  SCHEDULED
  PROCESSING
  PAID
  CANCELLED
  @@schema("financeiro")
}

enum LedgerEntryType {
  VENDA
  TAXA_DISK
  TAXA_SPREAD
  TAXA_ADVANCE
  TAXA_RIBEIT
  DESPESA
  REPASSE
  ANTECIPACAO
  ESTORNO
  AJUSTE
  TRANSFERENCIA
  @@schema("financeiro")
}

enum EventObligationCategory {
  VENUE_RENTAL
  ECAD
  STAGE_STRUCTURE
  ARTIST
  TAX
  SECURITY
  TICKETING_EQUIPMENT
  OTHER
  @@schema("financeiro")
}

enum ObligationStatus {
  RESERVED
  APPROVED
  PAID
  CANCELLED
  @@schema("financeiro")
}

enum CancellationStatus {
  UNDER_ANALYSIS
  APPROVED
  RECOMPOSITION_PENDING
  PROCESSING_REFUNDS
  COMPLETED
  REJECTED
  @@schema("financeiro")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  REFUNDED
  FAILED
  REJECTED
  @@schema("financeiro")
}

enum LedgerDirection {
  CREDIT
  DEBIT
  @@schema("financeiro")
}

enum TitleStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  RENEGOTIATED
  @@schema("financeiro")
}

enum MovementType {
  PAYMENT
  RECEIPT
  TRANSFER
  FEE
  INTEREST
  REVERSAL
  ADJUSTMENT
  @@schema("financeiro")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  @@schema("contabil")
}

enum AccountNature {
  DEBIT
  CREDIT
  @@schema("contabil")
}

enum PeriodStatus {
  OPEN
  CLOSED
  BLOCKED
  @@schema("contabil")
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  legalName   String?      @map("legal_name")
  document    String?
  status      TenantStatus @default(TRIAL)
  plan        String?
  timezone    String       @default("America/Sao_Paulo")
  locale      String       @default("pt-BR")
  currency    String       @default("BRL") @db.Char(3)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  addresses   Address[]
  companies   Company[]
  branches    Branch[]
  persons     Person[]
  users       User[]
  roles       Role[]
  auditLogs   AuditLog[]
  attachments Attachment[]
  workflows   Workflow[]
  events      DomainEvent[]
  rules       Rule[]
  financialAccounts FinancialAccount[]
  financialCategories FinancialCategory[]
  payableTitles PayableTitle[]
  receivableTitles ReceivableTitle[]
  financialMovements FinancialMovement[]
  transfers FinancialTransfer[]
  bankStatements BankStatement[]
  budgets Budget[]
  creditLimits CreditLimit[]
  eventWallets EventWallet[]
  feeDefinitions FeeDefinition[]
  saleFinancialSplits SaleFinancialSplit[]
  eventExpenses EventExpense[]
  settlementSchedules SettlementSchedule[]
  eventFinancialStatements EventFinancialStatement[]
  eventObligations EventObligation[]
  eventCancellations EventCancellation[]
  saleRefundRequests SaleRefundRequest[]
  producers Producer[]
  accountingAccounts AccountingAccount[]
  accountingPeriods AccountingPeriod[]
  costCenters CostCenter[]
  dimensions AnalyticalDimension[]
  fiscalTaxRules FiscalTaxRule[]
  fiscalDocuments FiscalDocument[]
  departments Department[]
  positions Position[]
  employees Employee[]
  benefits Benefit[]
  payrolls Payroll[]
  payrollEvents PayrollEvent[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  products Product[]
  warehouses Warehouse[]
  stockMovements StockMovement[]
  customers Customer[]
  salesOrders SalesOrder[]
  leads Lead[]
  opportunities Opportunity[]
  contracts Contract[]
  projects Project[]
  fixedAssets FixedAsset[]
  integrations Integration[]
  webhooks Webhook[]

  @@map("tenants")
  @@schema("core")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  postalCode  String?  @map("postal_code")
  street      String?
  number      String?
  complement  String?
  district    String?
  city        String?
  state       String?
  country     String   @default("BR")
  latitude    Decimal? @db.Decimal(10,7)
  longitude   Decimal? @db.Decimal(10,7)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  companies   Company[]
  branches    Branch[]
  persons     Person[]

  @@map("addresses")
  @@schema("core")
}

model Company {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  parentCompanyId      String?   @map("parent_company_id") @db.Uuid
  legalName            String    @map("legal_name")
  tradeName            String?   @map("trade_name")
  document             String?
  stateRegistration    String?   @map("state_registration")
  municipalRegistration String?  @map("municipal_registration")
  taxRegime            String?   @map("tax_regime")
  status               String    @default("ACTIVE")
  email                String?
  phone                String?
  website              String?
  addressId            String?   @map("address_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  parent       Company? @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  children     Company[] @relation("CompanyHierarchy")
  address      Address? @relation(fields: [addressId], references: [id])
  branches     Branch[]
  users        UserCompany[]
  auditLogs    AuditLog[]
  financialAccounts FinancialAccount[]
  payableTitles PayableTitle[]
  receivableTitles ReceivableTitle[]
  financialMovements FinancialMovement[]
  transfers FinancialTransfer[]
  budgets Budget[]
  eventWallets EventWallet[]
  saleFinancialSplits SaleFinancialSplit[]
  producers Producer[]
  accountingAccounts AccountingAccount[]
  accountingPeriods AccountingPeriod[]
  costCenters CostCenter[]
  fiscalDocuments FiscalDocument[]
  departments Department[]
  positions Position[]
  employees Employee[]
  payrolls Payroll[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  warehouses Warehouse[]
  salesOrders SalesOrder[]
  contracts Contract[]
  projects Project[]
  fixedAssets FixedAsset[]

  @@map("companies")
  @@schema("core")
}

model Branch {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  code                 String
  name                 String
  document             String?
  stateRegistration    String?   @map("state_registration")
  municipalRegistration String?  @map("municipal_registration")
  addressId            String?   @map("address_id") @db.Uuid
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  company  Company @relation(fields: [companyId], references: [id])
  address  Address? @relation(fields: [addressId], references: [id])
  users    UserBranch[]
  employees Employee[]
  financialAccounts FinancialAccount[]
  payableTitles PayableTitle[]
  receivableTitles ReceivableTitle[]
  fiscalDocuments FiscalDocument[]
  warehouses Warehouse[]
  fixedAssets FixedAsset[]

  @@unique([companyId, code])
  @@map("branches")
  @@schema("core")
}

model Person {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  document   String?
  birthDate  DateTime? @map("birth_date") @db.Date
  email      String?
  phone      String?
  gender     String?
  status     String   @default("ACTIVE")
  addressId  String?  @map("address_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  address    Address? @relation(fields: [addressId], references: [id])
  users      User[]
  employees  Employee[]
  customers  Customer[]

  @@map("persons")
  @@schema("core")
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  personId    String?    @map("person_id") @db.Uuid
  name        String
  email       String
  phone       String?
  passwordHash String    @map("password_hash")
  status      UserStatus @default(INVITED)
  lastLoginAt DateTime?  @map("last_login_at")
  mfaEnabled  Boolean    @default(false) @map("mfa_enabled")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  person      Person? @relation(fields: [personId], references: [id])
  roles       UserRole[]
  companies   UserCompany[]
  branches    UserBranch[]
  auditLogs   AuditLog[]
  attachments Attachment[]
  workflowActions WorkflowAction[]
  accountingPeriodsClosed AccountingPeriod[] @relation("PeriodClosedBy")
  journalEntriesCreated JournalEntry[]
  journalReversalsCreated JournalReversal[]
  purchaseRequests PurchaseRequest[]
  reconciliationMatches ReconciliationMatch[]
  leads Lead[]
  opportunities Opportunity[]
  projectsManaged Project[]
  projectTasks ProjectTask[]

  @@unique([tenantId, email])
  @@map("users")
  @@schema("core")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  systemRole  Boolean  @default(false) @map("system_role")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
  @@schema("core")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  module      String
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
  @@schema("core")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("core")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("core")
}

model UserCompany {
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid
  user      User @relation(fields: [userId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])

  @@id([userId, companyId])
  @@map("user_companies")
  @@schema("core")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  user     User @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@map("user_branches")
  @@schema("core")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  module     String
  entity     String
  entityId   String?  @map("entity_id") @db.Uuid
  action     String
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  user    User? @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
  @@schema("core")
}

model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  fileName    String   @map("file_name")
  storageKey  String   @map("storage_key")
  mimeType    String?  @map("mime_type")
  size        BigInt?
  checksum    String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User? @relation(fields: [createdBy], references: [id])

  @@map("attachments")
  @@schema("core")
}

model Workflow {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  module    String
  entity    String
  status    WorkflowStatus @default(DRAFT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  steps WorkflowStep[]
  instances WorkflowInstance[]

  @@map("workflows")
  @@schema("core")
}

model WorkflowStep {
  id             String @id @default(uuid()) @db.Uuid
  workflowId     String @map("workflow_id") @db.Uuid
  name           String
  sequence       Int
  approvalType   String @default("ANY") @map("approval_type")
  required       Boolean @default(true)

  workflow Workflow @relation(fields: [workflowId], references: [id])
  actions WorkflowAction[]

  @@unique([workflowId, sequence])
  @@map("workflow_steps")
  @@schema("core")
}

model WorkflowInstance {
  id           String @id @default(uuid()) @db.Uuid
  workflowId   String @map("workflow_id") @db.Uuid
  entityId     String @map("entity_id") @db.Uuid
  status       WorkflowInstanceStatus @default(PENDING)
  currentStep Int @default(1) @map("current_step")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  workflow Workflow @relation(fields: [workflowId], references: [id])
  actions WorkflowAction[]

  @@map("workflow_instances")
  @@schema("core")
}

model WorkflowAction {
  id                 String @id @default(uuid()) @db.Uuid
  workflowInstanceId  String @map("workflow_instance_id") @db.Uuid
  workflowStepId      String @map("workflow_step_id") @db.Uuid
  userId              String? @map("user_id") @db.Uuid
  action              String
  comment             String?
  createdAt           DateTime @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id])
  step WorkflowStep @relation(fields: [workflowStepId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@map("workflow_actions")
  @@schema("core")
}

model DomainEvent {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  eventType      String @map("event_type")
  aggregateType  String @map("aggregate_type")
  aggregateId    String @map("aggregate_id") @db.Uuid
  version        Int @default(1)
  payload        Json
  occurredAt     DateTime @default(now()) @map("occurred_at")
  processedAt    DateTime? @map("processed_at")
  status         EventStatus @default(PENDING)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  webhookDeliveries WebhookDelivery[]

  @@index([status, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
  @@schema("core")
}

model Rule {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  module     String
  event      String
  condition  Json @default("{}")
  action     Json @default("{}")
  priority   Int @default(100)
  version    Int @default(1)
  active     Boolean @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("core")
  @@map("rules")
}

model FinancialAccount {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  branchId        String? @map("branch_id") @db.Uuid
  type            FinancialAccountType
  name            String
  bankCode        String? @map("bank_code")
  agency          String?
  accountNumber   String? @map("account_number")
  currency        String @default("BRL") @db.Char(3)
  initialBalance  Decimal @default(0) @db.Decimal(19,4) @map("initial_balance")
  status          String @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  movements FinancialMovement[]
  outgoingTransfers FinancialTransfer[] @relation("TransferSource")
  incomingTransfers FinancialTransfer[] @relation("TransferDestination")
  bankStatements BankStatement[]

  @@schema("financeiro")
  @@map("financial_accounts")
}

model FinancialCategory {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid
  name      String
  type      String
  active    Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  payableTitles PayableTitle[]
  receivableTitles ReceivableTitle[]
  parent FinancialCategory? @relation("FinancialCategoryHierarchy", fields: [parentId], references: [id])
  children FinancialCategory[] @relation("FinancialCategoryHierarchy")

  @@schema("financeiro")
  @@map("financial_categories")
}

model PayableTitle {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  branchId        String? @map("branch_id") @db.Uuid
  supplierId      String? @map("supplier_id") @db.Uuid
  description     String
  documentNumber  String? @map("document_number")
  issueDate       DateTime @db.Date @map("issue_date")
  dueDate         DateTime @db.Date @map("due_date")
  totalAmount     Decimal @db.Decimal(19,4) @map("total_amount")
  currency        String @default("BRL") @db.Char(3)
  categoryId      String? @map("category_id") @db.Uuid
  costCenterId    String? @map("cost_center_id") @db.Uuid
  projectId       String? @map("project_id") @db.Uuid
  status          TitleStatus @default(OPEN)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  category FinancialCategory? @relation(fields: [categoryId], references: [id])
  installments PayableInstallment[]

  @@index([dueDate, status])
  @@schema("financeiro")
  @@map("payable_titles")
}

model PayableInstallment {
  id                String @id @default(uuid()) @db.Uuid
  payableTitleId    String @map("payable_title_id") @db.Uuid
  installmentNumber Int @map("installment_number")
  dueDate           DateTime @db.Date @map("due_date")
  amount            Decimal @db.Decimal(19,4)
  interestAmount    Decimal @default(0) @db.Decimal(19,4) @map("interest_amount")
  fineAmount        Decimal @default(0) @db.Decimal(19,4) @map("fine_amount")
  discountAmount    Decimal @default(0) @db.Decimal(19,4) @map("discount_amount")
  paidAmount        Decimal @default(0) @db.Decimal(19,4) @map("paid_amount")
  status            TitleStatus @default(OPEN)

  title PayableTitle @relation(fields: [payableTitleId], references: [id])

  @@unique([payableTitleId, installmentNumber])
  @@schema("financeiro")
  @@map("payable_installments")
}

model ReceivableTitle {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  companyId       String @map("company_id") @db.Uuid
  branchId        String? @map("branch_id") @db.Uuid
  customerId      String? @map("customer_id") @db.Uuid
  description     String
  documentNumber  String? @map("document_number")
  issueDate       DateTime @db.Date @map("issue_date")
  dueDate         DateTime @db.Date @map("due_date")
  totalAmount     Decimal @db.Decimal(19,4) @map("total_amount")
  currency        String @default("BRL") @db.Char(3)
  categoryId      String? @map("category_id") @db.Uuid
  costCenterId    String? @map("cost_center_id") @db.Uuid
  projectId       String? @map("project_id") @db.Uuid
